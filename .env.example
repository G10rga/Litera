# Copy to .env for local development. NEVER commit the real .env.

# development | testing | production
FLASK_CONFIG=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse litera-dev-secret-change-me outside local development.
SECRET_KEY=

# Required in production. Omit locally to fall back to instance/vepkhvi.db (SQLite).
# Example: postgresql+psycopg://user:password@host:5432/litera
DATABASE_URL=

# Cap the SQLAlchemy pool for small hosted Postgres plans (default 5 in production).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=2

# Address shown on /contact and used as the destination for contact messages.
CONTACT_EMAIL=litera.support@gmail.com

# Public site origin for absolute sitemap/canonical URLs (no trailing slash).
# PUBLIC_BASE_URL=https://example.com

# --- SMTP (password reset). Leave MAIL_SERVER blank in development to log only. ---
# Resend example:
#   MAIL_SERVER=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=true
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=re_xxx
#   MAIL_DEFAULT_SENDER=Litera <noreply@yourdomain.com>
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Optional error tracking
# SENTRY_DSN=https://...@o....ingest.sentry.io/...

# Multi-worker rate-limit store (default memory:// is fine for one process)
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
